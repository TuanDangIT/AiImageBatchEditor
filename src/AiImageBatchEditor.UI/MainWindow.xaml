<Window x:Class="AiImageBatchEditor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Image Batch Editor"
        Width="1200" Height="820"
        MinWidth="950" MinHeight="650">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="AI Image Batch Editor"
                   FontSize="26" FontWeight="SemiBold"
                   Margin="4,0,4,12"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Project setup" Margin="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="Input folder"/>
                        <DockPanel>
                            <TextBox Text="{Binding InputFolder, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button DockPanel.Dock="Right" Content="Browse"
                                    Click="BrowseInput_Click"/>
                        </DockPanel>

                        <TextBlock Text="Output folder"/>
                        <DockPanel>
                            <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button DockPanel.Dock="Right" Content="Browse"
                                    Click="BrowseOutput_Click"/>
                        </DockPanel>

                        <TextBlock Text="Reference images" Margin="4,12,4,4"/>
                        <Button Content="Add reference images"
                                Click="AddReferences_Click"/>

                        <ListBox ItemsSource="{Binding References}" Height="180" Margin="4">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Remove"
                                                Click="RemoveReference_Click"
                                                Tag="{Binding}"/>
                                        <TextBlock Text="{Binding}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Concurrency" Margin="4,8,4,0"/>
                        <ComboBox SelectedValue="{Binding MaxConcurrency}"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Content="1" Tag="1"/>
                            <ComboBoxItem Content="2" Tag="2"/>
                            <ComboBoxItem Content="3" Tag="3"/>
                            <ComboBoxItem Content="4" Tag="4"/>
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Preview" Margin="4">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Input" FontWeight="Bold"/>
                        <Image Source="{Binding PreviewInput}" Stretch="Uniform" Height="280"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="AI output" FontWeight="Bold"/>
                        <Image Source="{Binding PreviewOutput}" Stretch="Uniform" Height="280"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="2" Header="Instructions" Margin="4">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Describe how every input image should be transformed. Reference images are sent with every edit request."
                           TextWrapping="Wrap"/>

                <TextBox Grid.Row="1" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding Instructions, UpdateSourceTrigger=PropertyChanged}"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Choose test image" Click="ChooseTestImage_Click"/>
                    <Button Content="Test AI edit"
                            IsEnabled="{Binding CanTest}"
                            Click="TestEdit_Click"/>
                    <Button Content="Process batch"
                            IsEnabled="{Binding CanProcess}"
                            Click="ProcessBatch_Click"/>
                    <Button Content="Cancel"
                            IsEnabled="{Binding IsProcessing}"
                            Click="Cancel_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Batch jobs" Margin="4">
            <ListView ItemsSource="{Binding Jobs}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="File" Width="260"
                                        DisplayMemberBinding="{Binding FileName}"/>
                        <GridViewColumn Header="Status" Width="110"
                                        DisplayMemberBinding="{Binding Status}"/>
                        <GridViewColumn Header="Error" Width="500"
                                        DisplayMemberBinding="{Binding ErrorMessage}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>

        <StatusBar Grid.Row="4" Margin="4">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem Width="250">
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
